{
  "manifest_version": 3,
  "name": "Please Don't Scroll",
  "version": "1.0",
  "description": "Your digital exit sign.",
  "permissions": ["storage", "declarativeNetRequest", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icons/favicon.ico",
    "48": "assets/icons/favicon.ico",
    "128": "assets/icons/favicon.ico"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/favicon.ico",
      "48": "assets/icons/favicon.ico",
      "128": "assets/icons/favicon.ico"
    }
  }
}
{
  "manifest_version": 3,
  "name": "Please Don't Scroll",
  "version": "1.0",
  "description": "Block Instagram and TikTok to stay productive.",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/favicon/favicon-96x96.png",
      "32": "assets/favicon/favicon-96x96.png",
      "48": "assets/favicon/favicon-96x96.png",
      "128": "assets/favicon/apple-touch-icon.png"
    }
  },
  "icons": {
    "16": "assets/favicon/favicon-96x96.png",
    "32": "assets/favicon/favicon-96x96.png",
    "48": "assets/favicon/favicon-96x96.png",
    "128": "assets/favicon/apple-touch-icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
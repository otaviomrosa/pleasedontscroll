{
  "manifest_version": 3,
  "name": "Please Don't Scroll",
  "version": "3.0",
  "description": "Start a focus session and distracting sites stay blocked until the timer ends. Friction Mode or Strict Mode, your choice.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "https://fqnoxcycqnnflwdgczvi.supabase.co/*"
  ],
  "action": {
    "default_popup": "extension/popup/popup.html",
    "default_icon": {
      "16": "extension/assets/icons/icon-16.png",
      "32": "extension/assets/icons/icon-32.png",
      "48": "extension/assets/icons/icon-48.png",
      "128": "extension/assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "extension/assets/icons/icon-16.png",
    "32": "extension/assets/icons/icon-32.png",
    "48": "extension/assets/icons/icon-48.png",
    "128": "extension/assets/icons/icon-128.png"
  },
  "background": {
    "service_worker": "extension/background/index.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://pleasedontscroll.com/*",
      "https://www.pleasedontscroll.com/*",
      "http://localhost:8000/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: https://icons.duckduckgo.com; connect-src 'self' https://fqnoxcycqnnflwdgczvi.supabase.co;"
  }
}

{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dashboard.html",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/web/dashboard.html"
    },
    {
      "source": "/pricing",
      "destination": "/web/pricing.html"
    },
    {
      "source": "/privacy",
      "destination": "/web/privacy.html"
    },
    {
      "source": "/site.css",
      "destination": "/web/site.css"
    },
    {
      "source": "/site.js",
      "destination": "/web/site.js"
    },
    {
      "source": "/assets/:path*",
      "destination": "/web/assets/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "/web/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/web/sitemap.xml"
    },
    {
      "source": "/favicon.ico",
      "destination": "/web/assets/icons/favicon/favicon.ico"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://icons.duckduckgo.com; connect-src 'self' https://fqnoxcycqnnflwdgczvi.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
